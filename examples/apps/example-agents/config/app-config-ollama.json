{
  "app": {
    "name": "hopeit-agents-example-agents",
    "version": "0.1"
  },
  "engine": {
    "import_modules": ["hopeit_agents.example_agents"]
  },
  "app_connections": {
    "expert-agent": {
      "name": "hopeit-agents-example-agents",
      "version": "0.1",
      "client": "hopeit.apps_client.AppsClient"
    }
  },
  "settings": {
    "expert-agent": {
      "connection_str": "http://127.0.0.1:8020",
      "auth_strategy": "UNSECURED",
      "ssl": false
    },
    "agent_model": {
      "provider": "ollama",
      "model_name": "${OLLAMA_MODEL_NAME}",
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "OLLAMA_API_KEY"
    },
    "main_agent": {
      "instructions_path": "examples/apps/example-agents/config/agents/main-agent-prompt.md",
      "request_limit": 12,
      "tool_calls_limit": 20,
      "tool_retries": 1,
      "output_retries": 3
    },
    "expert_agent": {
      "instructions_path": "examples/apps/example-agents/config/agents/expert-agent-prompt.md",
      "request_limit": 10,
      "tool_calls_limit": 20,
      "tool_retries": 1,
      "output_retries": 3
    },
    "agents.main_agent": {
      "response_timeout": 600
    },
    "agents.expert_agent": {
      "response_timeout": 600
    }
  },
  "events": {
    "agents.main_agent": {
      "type": "POST",
      "setting_keys": ["agent_model", "main_agent"],
      "connections": [
        {
          "app_connection": "expert-agent",
          "event": "agents.expert_agent",
          "type": "POST"
        }
      ]
    },
    "agents.expert_agent": {
      "type": "POST",
      "setting_keys": ["agent_model", "expert_agent"]
    }
  }
}
